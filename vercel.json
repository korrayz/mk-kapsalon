{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/admin", "destination": "/admin/public/index.html" },
    { "source": "/admin.css", "destination": "/admin/public/admin.css" },
    { "source": "/admin.js", "destination": "/admin/public/admin.js" }
  ]
}
